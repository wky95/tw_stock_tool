    {"class": "features_labels_models_signals", "retention": "UNKNOWN", "deletion_deadline": "UNKNOWN", "backup_permitted": "UNKNOWN", "backup_expiry": "UNKNOWN", "derived_survival": "UNKNOWN", "owner": "provider_legal_operator"},
    {"class": "coverage_reconciliation_audit", "retention": "UNKNOWN", "deletion_deadline": "UNKNOWN", "backup_permitted": "UNKNOWN", "backup_expiry": "UNKNOWN", "derived_survival": "UNKNOWN", "owner": "provider_legal_operator"}
  ],
  "required_answers": [
