  },
  "migration": [
    "freeze and checksum both provider versions",
    "record the last common completeness and sequence watermark",
    "stop writers and verify entitlement, retention and target-host rights",
    "activate one exact provider/configuration version",
    "replay from the common watermark into a new immutable namespace",
    "reconcile all critical datasets before releasing readers"
  ],
  "rollback": {
    "triggers": ["entitlement uncertainty", "stale or gapped stream", "identifier ambiguity", "missing revision", "unknown tradability or calendar", "coverage below threshold", "unexplained disagreement", "retention violation"],
    "steps": ["block new decisions", "preserve evidence and watermarks", "verify the prior version remains entitled and fresh", "restore the exact prior configuration", "replay from the common watermark", "require complete reconciliation before release"],
    "fail_closed": "If the prior source is stale, expired, incomplete or unlicensed, stop instead of falling back."
  },
