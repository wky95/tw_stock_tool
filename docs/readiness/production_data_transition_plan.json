{
  "schema_version": 1,
  "as_of": "2026-09-24",
  "parallel_run": {
    "window": "operator_must_define_representative_history_and_live_observation_window",
    "namespaces_must_be_distinct": true,
    "comparison_keys": ["stable_instrument_id", "event_time", "revision_id"],
    "daily_reports": ["field_and_record_coverage", "revision_lag", "identifier_mapping", "tradability_and_calendar", "benchmark_and_market_cap", "stream_freshness_sequence_and_recovery", "provider_value_disagreement"],
    "acceptance": {"unexplained_critical_differences": 0, "unresolved_gaps": 0, "unknown_tradability": 0, "silent_fallbacks": 0, "pit_coverage": "1.000000"},
